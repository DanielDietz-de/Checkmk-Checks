#!/usr/bin/env python3
"""Probe public HTTPS endpoints for freshness without delegated SSRF."""

from __future__ import annotations

import argparse
import ipaddress
import json
import re
import socket
import sys
from dataclasses import dataclass
from datetime import datetime, timezone
from email.utils import parsedate_to_datetime
from typing import Any
from urllib.parse import urlsplit

import requests
import urllib3

MAX_RESPONSE_BYTES = 1024 * 1024
MAX_ENDPOINTS = 100
MAX_JSON_PATH_LENGTH = 512
MAX_NAME_LENGTH = 256
MAX_URL_LENGTH = 2048


class EndpointError(RuntimeError):
    """Raised when an endpoint is unsafe or cannot be probed reliably."""


@dataclass(frozen=True)
class PublicHTTPSDestination:
    """A public HTTPS URL pinned to one address from its validated DNS answer."""

    url: str
    hostname: str
    port: int
    address: str
    request_target: str
    host_header: str


class PinnedHTTPSResponse:
    """Small response adapter for a single pinned urllib3 connection pool."""

    def __init__(
        self,
        response: urllib3.response.BaseHTTPResponse,
        pool: urllib3.HTTPSConnectionPool,
    ) -> None:
        """Initialize the instance and its required runtime state."""
        self._response = response
        self._pool = pool
        self.status_code = response.status
        self.headers = response.headers

    @property
    def is_redirect(self) -> bool:
        """Return whether redirect is true for the supplied input."""
        return 300 <= self.status_code < 400

    def iter_content(self, chunk_size: int = 65536):
        """Handle iter content for this source file's runtime workflow."""
        yield from self._response.stream(amt=chunk_size, decode_content=True)

    def close(self) -> None:
        """Handle close for this source file's runtime workflow."""
        self._response.release_conn()
        self._pool.close()


def _host_header(hostname: str, port: int) -> str:
    """Handle host header for this source file's runtime workflow."""
    rendered = f"[{hostname}]" if ":" in hostname else hostname
    return rendered if port == 443 else f"{rendered}:{port}"


def validate_public_https_url(value: str) -> PublicHTTPSDestination:
    """Validate public https url and reject invalid input."""
    url = value.strip()
    if len(url) > MAX_URL_LENGTH:
        raise EndpointError(f"URL must not exceed {MAX_URL_LENGTH} characters")
    parsed = urlsplit(url)
    if parsed.scheme != "https" or not parsed.hostname:
        raise EndpointError("URL must be an absolute HTTPS URL")
    if parsed.username or parsed.password or parsed.fragment:
        raise EndpointError("URL must not contain credentials or a fragment")
    try:
        port = parsed.port or 443
    except ValueError as exc:
        raise EndpointError("URL contains an invalid port") from exc
    try:
        addresses = {
            result[4][0]
            for result in socket.getaddrinfo(
                parsed.hostname,
                port,
                type=socket.SOCK_STREAM,
            )
        }
    except socket.gaierror as exc:
        raise EndpointError(f"DNS resolution failed: {exc}") from exc
    if not addresses:
        raise EndpointError("DNS resolution returned no addresses")
    parsed_addresses = [ipaddress.ip_address(address) for address in addresses]
    if any(not address.is_global for address in parsed_addresses):
        raise EndpointError("URL resolves to a non-public address")
    selected = min(
        parsed_addresses,
        key=lambda address: (address.version != 4, int(address)),
    )
    request_target = parsed.path or "/"
    if parsed.query:
        request_target = f"{request_target}?{parsed.query}"
    return PublicHTTPSDestination(
        url=url,
        hostname=parsed.hostname,
        port=port,
        address=str(selected),
        request_target=request_target,
        host_header=_host_header(parsed.hostname, port),
    )


def pinned_https_get(
    destination: PublicHTTPSDestination,
    *,
    headers: dict[str, str],
    timeout: float,
) -> PinnedHTTPSResponse:
    """Connect to the validated IP while verifying TLS for the URL hostname."""

    pool = urllib3.HTTPSConnectionPool(
        destination.address,
        port=destination.port,
        cert_reqs="CERT_REQUIRED",
        ca_certs=requests.certs.where(),
        assert_hostname=destination.hostname,
        server_hostname=destination.hostname,
        maxsize=1,
        block=True,
    )
    request_headers = dict(headers)
    request_headers["Host"] = destination.host_header
    try:
        response = pool.urlopen(
            "GET",
            destination.request_target,
            headers=request_headers,
            timeout=urllib3.Timeout(connect=timeout, read=timeout),
            redirect=False,
            retries=False,
            preload_content=False,
            assert_same_host=False,
        )
    except Exception:
        pool.close()
        raise
    return PinnedHTTPSResponse(response, pool)


def parse_date(value: Any) -> datetime | None:
    """Parse date into its normalized representation."""
    if value is None:
        return None
    text = str(value).strip()
    if not text or len(text) > 256:
        return None
    try:
        parsed = parsedate_to_datetime(text)
    except (TypeError, ValueError):
        parsed = None
    if parsed is None:
        try:
            parsed = datetime.fromisoformat(text.replace("Z", "+00:00"))
        except ValueError:
            return None
    return parsed.replace(tzinfo=timezone.utc) if parsed.tzinfo is None else parsed


def lookup_json_path(data: Any, path: str) -> Any:
    """Handle lookup json path for this source file's runtime workflow."""
    if not path or len(path) > MAX_JSON_PATH_LENGTH:
        return None
    current = data
    for raw_segment in path.split("."):
        match = re.fullmatch(r"([^\[\]]+)(?:\[(\d+)\])?", raw_segment)
        if match is None or not isinstance(current, dict):
            return None
        current = current.get(match.group(1))
        if match.group(2) is not None:
            if not isinstance(current, list):
                return None
            index = int(match.group(2))
            if index >= len(current):
                return None
            current = current[index]
    return current


def compute_age(source: str, headers: Any, body: bytes):
    """Handle compute age for this source file's runtime workflow."""
    now = datetime.now(timezone.utc)
    if source == "age_header":
        raw = headers.get("Age")
        try:
            age = int(float(raw))
        except (TypeError, ValueError):
            return None, None, "response has no numeric Age header"
        return max(0, age), f"Age: {raw}", None

    if source.startswith("date_header"):
        header = source.partition(":")[2].strip() or "Last-Modified"
        if not re.fullmatch(r"[A-Za-z0-9-]{1,128}", header):
            return None, None, "invalid response header name"
        raw = headers.get(header)
        parsed = parse_date(raw)
        if parsed is None:
            return None, None, f"cannot parse {header} response header"
        return max(0, int((now - parsed).total_seconds())), f"{header}: {raw}", None

    if source.startswith("json_path:"):
        path = source.partition(":")[2].strip()
        try:
            decoded = json.loads(body)
        except (UnicodeDecodeError, json.JSONDecodeError):
            return None, None, "response is not valid UTF-8 JSON"
        if not isinstance(decoded, (dict, list)):
            return None, None, "JSON root must be an object or list"
        value = lookup_json_path(decoded, path)
        if value is None:
            return None, None, "configured JSON path was not found"
        if isinstance(value, (int, float)) and not isinstance(value, bool):
            return max(0, int(value)), f"{path} = {value}", None
        parsed = parse_date(value)
        if parsed is None:
            return None, None, "JSON path value is not a supported date"
        return max(0, int((now - parsed).total_seconds())), f"{path} = {value}", None

    return None, None, "unsupported freshness source"


def read_bounded(response: PinnedHTTPSResponse) -> bytes:
    """Read bounded from its configured source."""
    body = bytearray()
    for chunk in response.iter_content(chunk_size=65536):
        body.extend(chunk)
        if len(body) > MAX_RESPONSE_BYTES:
            raise EndpointError("response exceeds the 1 MiB limit")
    return bytes(body)


def probe_endpoint(spec: dict[str, Any]) -> dict[str, Any]:
    """Handle probe endpoint for this source file's runtime workflow."""
    name = str(spec.get("name") or "endpoint")[:MAX_NAME_LENGTH]
    raw_url = str(spec.get("url") or "")
    result = {
        "name": name,
        "url": raw_url[:MAX_URL_LENGTH],
        "source": str(spec.get("source") or "age_header")[:1024],
        "ok": False,
        "error": None,
        "http_status": None,
        "age_seconds": None,
        "detail": None,
    }
    response: PinnedHTTPSResponse | None = None
    try:
        destination = validate_public_https_url(raw_url)
        timeout = float(spec.get("timeout", 15.0))
        if not 0.5 <= timeout <= 60:
            raise EndpointError("timeout must be between 0.5 and 60 seconds")
        response = pinned_https_get(
            destination,
            headers={"User-Agent": "checkmk-endpoint-age/2.0"},
            timeout=timeout,
        )
        result["http_status"] = response.status_code
        if response.is_redirect:
            raise EndpointError("endpoint returned an unexpected redirect")
        if not 200 <= response.status_code < 300:
            raise EndpointError(f"endpoint returned HTTP {response.status_code}")
        body = read_bounded(response)
        age, detail, error = compute_age(result["source"], response.headers, body)
        if error:
            raise EndpointError(error)
        result.update(ok=True, age_seconds=age, detail=str(detail)[:1024])
    except (EndpointError, urllib3.exceptions.HTTPError, OSError, ValueError) as exc:
        result["error"] = str(exc)[:1024]
    finally:
        if response is not None:
            response.close()
    return result


def parse_arguments(argv: list[str] | None = None) -> argparse.Namespace:
    """Parse arguments into its normalized representation."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--endpoint", action="append", default=[])
    args = parser.parse_args(argv)
    if not args.endpoint:
        parser.error("At least one --endpoint is required")
    if len(args.endpoint) > MAX_ENDPOINTS:
        parser.error(f"At most {MAX_ENDPOINTS} endpoints are supported")
    return args


def main(argv: list[str] | None = None) -> int:
    """Run the command-line entry point and return its result."""
    args = parse_arguments(argv)
    print("<<<endpoint_age:sep(0)>>>")
    for raw in args.endpoint:
        try:
            spec = json.loads(raw)
            if not isinstance(spec, dict):
                raise ValueError("endpoint spec must be a JSON object")
            result = probe_endpoint(spec)
        except (json.JSONDecodeError, ValueError) as exc:
            result = {"name": "invalid endpoint", "ok": False, "error": str(exc)[:1024]}
        print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
