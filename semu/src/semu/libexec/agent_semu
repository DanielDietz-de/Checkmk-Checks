#!/usr/bin/env python3
"""Fetch SEMU single-sensor frame status over authenticated HTTPS."""

import argparse
from pathlib import Path

import requests
from requests.auth import HTTPBasicAuth


def _resolve_secret_reference(reference: str) -> str:
    """Resolve a Checkmk password-store reference passed by server-side calls."""
    try:
        secret_id, store_path = reference.split(":", 1)
    except ValueError as exc:
        raise ValueError("invalid Checkmk password-store reference") from exc
    from cmk.utils.password_store import lookup

    return lookup(Path(store_path), secret_id)


def parse_arguments():
    parser = argparse.ArgumentParser(description="SEMU special agent")
    parser.add_argument("--hostname", required=True)
    parser.add_argument("--username", required=True)
    password_group = parser.add_mutually_exclusive_group(required=True)
    password_group.add_argument("--password", help="Password for direct command-line testing")
    password_group.add_argument("--password-id", help="Checkmk password-store reference")
    parser.add_argument("--timeout", type=float, default=30.0)
    parser.add_argument("--ca-file", help="Private CA bundle used to verify the SEMU endpoint")
    parser.add_argument("--no-cert-check", action="store_true", help="Explicitly disable TLS verification")
    args = parser.parse_args()
    args.password = (
        args.password
        if args.password is not None
        else _resolve_secret_reference(args.password_id)
    )
    return args


def main() -> int:
    args = parse_arguments()
    session = requests.Session()
    session.trust_env = False
    verify: bool | str = False if args.no_cert_check else (args.ca_file or True)
    response = session.get(
        f"https://{args.hostname}/api/v5/singlesensor/status",
        auth=HTTPBasicAuth(args.username, args.password),
        verify=verify,
        timeout=args.timeout,
        allow_redirects=False,
    )
    response.raise_for_status()
    payload = response.json()
    if not isinstance(payload, dict):
        raise RuntimeError("SEMU API returned a non-object JSON response")

    print("<<<semu_frames>>>")
    for key, value in payload.items():
        print(f"{key} {value}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
